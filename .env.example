# ==========================================
# FOREX TRADING ROBOT CONFIGURATION
# ==========================================

# Bot settings
BOT_NAME=Forex Paper Trading Robot
DEBUG=True

# Safety setting
# Keep this True while developing and testing.
PAPER_TRADING=True


# ==========================================
# ACCOUNT SETTINGS
# ==========================================

STARTING_BALANCE=10000
ACCOUNT_CURRENCY=USD


# ==========================================
# RISK MANAGEMENT
# ==========================================

# Percentage of account balance risked per trade
RISK_PER_TRADE_PERCENT=1.0

# Maximum number of simultaneous open trades
MAX_OPEN_TRADES=5

# Maximum trades allowed per day
MAX_TRADES_PER_DAY=10

# Stop loss percentage
STOP_LOSS_PERCENT=1.0

# Take profit percentage
TAKE_PROFIT_PERCENT=2.0


# ==========================================
# MARKET DATA
# ==========================================

# Current provider
DATA_PROVIDER=SIMULATED

# Trading timeframe
TIMEFRAME=1h

# Number of candles used for analysis
CANDLE_LIMIT=250


# ==========================================
# STRATEGY SETTINGS
# ==========================================

# EMA periods
FAST_EMA_PERIOD=9
SLOW_EMA_PERIOD=21

# RSI settings
RSI_PERIOD=14

# RSI thresholds
RSI_BUY_LEVEL=55
RSI_SELL_LEVEL=45


# ==========================================
# SIMULATED BROKER SETTINGS
# ==========================================

# Simulated spread percentage
SIMULATED_SPREAD_PERCENT=0.01

# Simulated slippage percentage
SIMULATED_SLIPPAGE_PERCENT=0.005


# ==========================================
# ROBOT SETTINGS
# ==========================================

# Time between market scans
SCAN_INTERVAL_SECONDS=30
